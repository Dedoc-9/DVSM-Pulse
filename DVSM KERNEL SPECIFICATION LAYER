public enum DVSMExecutionPhase: UInt8 {

    /// system is initializing topology
    case boot

    /// topology is mutable (control plane only)
    case configuration

    /// execution is running (HOT/MID/COLD active)
    case active

    /// execution frozen (no topology mutation allowed)
    case frozen

    /// system shutting down / draining
    case shutdown
}

