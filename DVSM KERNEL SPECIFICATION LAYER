// =====================================================
// MARK: - SYSTEM TOPOLOGY (CONTROL PLANE MODEL)
// =====================================================

public final class DVSMSystemTopology {

    public private(set) var numaNodes: [DVSMNUMANodeID: DVSMNUMANode]
    public private(set) var shardBindings: [DVSMShardID: DVSMAffinityBinding]

    public private(set) var topologyVersion: UInt64
    public private(set) var executionPhase: DVSMExecutionPhase

    public init(
        numaNodes: [DVSMNUMANodeID: DVSMNUMANode],
        shardBindings: [DVSMShardID: DVSMAffinityBinding],
        topologyVersion: UInt64 = 1,
        executionPhase: DVSMExecutionPhase = .boot
    ) {
        self.numaNodes = numaNodes
        self.shardBindings = shardBindings
        self.topologyVersion = topologyVersion
        self.executionPhase = executionPhase
    }

    // =================================================
    // LOOKUP (READ ONLY HOT SAFE)
    // =================================================

    public func binding(for shard: DVSMShardID) -> DVSMAffinityBinding? {
        shardBindings[shard]
    }

    // =================================================
    // SNAPSHOT (DETERMINISTIC STATE EXPORT)
    // =================================================

    public func snapshot() -> DVSMTopologySnapshot {

        let hashInput = "\(topologyVersion)-\(shardBindings.count)-\(executionPhase)"
        let hash = String(hashInput.hashValue)

        return DVSMTopologySnapshot(
            version: topologyVersion,
            bindings: shardBindings,
            createdAt: UInt64(Date().timeIntervalSince1970),
            topologyHash: hash
        )
    }

    // =================================================
    // TOPOLOGY MUTATION (CONTROL PLANE ONLY)
    // =================================================

    public func proposeBindingUpdate(
        shard: DVSMShardID,
        newBinding: DVSMAffinityBinding
    ) {

        guard executionPhase == .configuration else {
            fatalError("Topology mutation only allowed in configuration phase")
        }

        shardBindings[shard] = newBinding
        topologyVersion += 1
    }

    // =================================================
    // EXECUTION PHASE CONTROL (NEW CRITICAL INVARIANT)
    // =================================================

    public func enterExecutionPhase() {
        guard executionPhase == .configuration else {
            fatalError("Invalid phase transition")
        }
        executionPhase = .active
    }

    public func freezeTopology() {
        executionPhase = .frozen
    }
}

// =====================================================
// MARK: - LIFECYCLE TRANSITION RULES (NEW)
// =====================================================

public struct DVSMShardLifecycleRules {

    public static func isValidTransition(
        from: DVSMShardLifecycleState,
        to: DVSMShardLifecycleState
    ) -> Bool {

        switch (from, to) {

        case (.active, .draining): return true
        case (.draining, .frozen): return true
        case (.frozen, .active): return true
        case (.active, .migrating): return true
        case (.migrating, .active): return true

        default:
            return false
        }
    }
}

