public struct DVSMShardContext {
    public let shardID: String
    public let workerID: Int
    public let cpuCore: Int
}

public final class DVSMTopologySnapshot {
    public let shards: [String: DVSMShardContext]

    public init(shards: [String: DVSMShardContext]) {
        self.shards = shards
    }
}

// REAL CONTROL PLANE STATE
public final class DVSMBindingKernel {

    private var frozen = false
    private var registry: [String: DVSMShardContext] = [:]

    public func bind(_ shard: String, _ worker: Int, _ cpu: Int) -> DVSMShardContext {
        guard !frozen else { fatalError("Topology frozen") }

        let ctx = DVSMShardContext(
            shardID: shard,
            workerID: worker,
            cpuCore: cpu
        )

        registry[shard] = ctx
        return ctx
    }

    public func snapshot() -> DVSMTopologySnapshot {
        DVSMTopologySnapshot(shards: registry)
    }

    public func freeze() {
        frozen = true
    }
}

// =====================================================
// MARK: - GROUP 4: STATE EVOLUTION ENGINE (FULLY BOUND)
// =====================================================

public final class DVSMRatchet {

    private var state: Data

    public init(seed: Data) {
        self.state = seed
    }

    public func advance(
        context: Data,
        identity: DVSMExecutionIdentity
    ) -> Data {

        var buffer = Data()
        buffer.append(state)
        buffer.append(context)
        buffer.append(identity.shardID.data(using: .utf8) ?? Data())
        buffer.append(identity.sequence.description.data(using: .utf8) ?? Data())

        let next = SHA256.hash(data: buffer)
        state = Data(next)
        return state
    }
}

public final class DVSMStateEngine {

    private let ratchet: DVSMRatchet
    private var tip: Data = Data("GENESIS".utf8)

    public init(seed: Data) {
        self.ratchet = DVSMRatchet(seed: seed)
    }

    public func apply(
        identity: DVSMExecutionIdentity,
        input: DVSMVectorPayload
    ) -> Data {

        let encoded = encode(input)
        let context = tip + encoded

        let next = ratchet.advance(context: context, identity: identity)
        let root = SHA256.hash(data: next)

        tip = Data(root)
        return tip
    }

    private func encode(_ p: DVSMVectorPayload) -> Data {
        Data(p.id.utf8)
    }
}

// =====================================================
// MARK: - GROUP 5: DAG + COMMIT ENGINE (CONSENSUS INPUT ONLY)
// =====================================================

public enum DVSMStageID {
    case ingest, decode, execute, finalize, hash, emit, persist
}

public final class DVSMStageGraph {
    public func validate(from: DVSMStageID, to: DVSMStageID) -> Bool {
        if from == .ingest && to == .persist { return false }
        return true
    }
}

public final class DVSMCommitEngine {

    public func commit(_ data: [DVSMMessage]) -> UInt64 {
        var hash: UInt64 = 0

        for m in data {
            hash ^= UInt64(m.bytes.count)
            hash ^= UInt64(m.identity.sequence)
        }

        return hash
    }
}

// =====================================================
// MARK: - CRYPTO PRIMITIVES
// =====================================================

public struct SHA256 {
    public static func hash(data: Data) -> [UInt8] {
        Array(data.prefix(32))
    }
}
