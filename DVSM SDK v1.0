//
// =====================================================
// DVSM SDK v1.0
// Deterministic Execution System Interface Layer
// =====================================================
//
// ROLE:
// This SDK defines the ONLY safe external interface to DVSM.
//
// It provides:
// - Execution identity contract
// - Deterministic submission API
// - State evolution abstraction
// - Commit lineage output
//
// IMPORTANT:
// The SDK does NOT expose internal orchestration,
// topology mutation, or execution scheduling.
//
// It MAY compute deterministic results,
// but does NOT define system behavior beyond contract guarantees.
//
// =====================================================

import Foundation
import CryptoKit

// =====================================================
// MARK: - CORE TYPES
// =====================================================

public enum DVSMExecutionMode: UInt8 {
    case strict
    case hybrid
    case adaptive
}

// -----------------------------------------------------
// Cross-layer execution identity (aligned with G3/G4)
// -----------------------------------------------------

public struct DVSMExecutionIdentity: Hashable, Sendable {

    public let shard: String
    public let generation: UInt64
    public let worker: Int
    public let timestamp: UInt64

    public init(
        shard: String,
        generation: UInt64,
        worker: Int,
        timestamp: UInt64
    ) {
        self.shard = shard
        self.generation = generation
        self.worker = worker
        self.timestamp = timestamp
    }
}

// -----------------------------------------------------

public struct DVSMVectorPayload {
    public let id: String
    public let vector: [Float]
    public let timestamp: UInt64
}

// =====================================================
// MARK: - RESULT MODEL
// =====================================================

public struct DVSMResult {
    public let identity: DVSMExecutionIdentity
    public let stateRoot: Data
    public let commitRoot: UInt64
}

// =====================================================
// MARK: - EXECUTION POLICY
// =====================================================

public struct DVSMExecutionPolicy {

    public let maxInstability: Float
    public let minConfidence: Float
    public let minReliability: Float

    public func validate(
        instability: Float,
        confidence: Float,
        reliability: Float
    ) -> Bool {
        instability <= maxInstability &&
        confidence >= minConfidence &&
        reliability >= minReliability
    }
}

// =====================================================
// MARK: - TOPOLOGY VIEW (READ ONLY)
// =====================================================

public struct DVSMShardContext {
    public let shard: String
    public let worker: Int
    public let cpuCore: Int
}

// =====================================================
// MARK: - TOPOLOGY SNAPSHOT
// =====================================================

public final class DVSMTopologySnapshot {

    public let shards: [String: DVSMShardContext]

    public init(shards: [String: DVSMShardContext]) {
        self.shards = shards
    }

    public func resolve(_ id: String) -> DVSMShardContext? {
        shards[id]
    }
}

// =====================================================
// MARK: - CLIENT (SDK ENTRY POINT)
// =====================================================
//
// NOTE:
// This client is a deterministic projection layer.
// It does NOT represent runtime execution authority.
// =====================================================

public final class DVSMClient {

    private let mode: DVSMExecutionMode
    private let policy: DVSMExecutionPolicy

    /// Local deterministic state projection (SDK-level view only)
    private var stateTip: Data = Data("GENESIS".utf8)

    public init(
        mode: DVSMExecutionMode,
        policy: DVSMExecutionPolicy
    ) {
        self.mode = mode
        self.policy = policy
    }

    // =================================================
    // SUBMIT EXECUTION TASK
    // =================================================
    //
    // Produces deterministic projection of:
    // - state root (cryptographic evolution)
    // - commit root (lineage binding)
    // =================================================

    public func submit(
        payload: DVSMVectorPayload,
        identity: DVSMExecutionIdentity,
        instability: Float,
        confidence: Float,
        reliability: Float
    ) -> DVSMResult? {

        guard policy.validate(
            instability: instability,
            confidence: confidence,
            reliability: reliability
        ) else {
            return nil
        }

        let encoded = encode(payload)

        // deterministic state evolution
        let context = stateTip + encoded
        let nextState = SHA256.hash(data: context)

        stateTip = Data(nextState)

        // lineage-bound commit root (SDK-level abstraction)
        let commit = fnv64(identity: identity, data: encoded)

        return DVSMResult(
            identity: identity,
            stateRoot: stateTip,
            commitRoot: commit
        )
    }

    // =================================================
    // STATE QUERY (READ ONLY)
    // =================================================

    public func currentState() -> Data {
        stateTip
    }

    // =================================================
    // DETERMINISTIC ENCODING
    // =================================================

    private func encode(_ payload: DVSMVectorPayload) -> Data {

        var out = Data()
        out.append(payload.id.utf8)

        for v in payload.vector {
            var bits = v.bitPattern.littleEndian
            withUnsafeBytes(of: &bits) { out.append(contentsOf: $0) }
        }

        return out
    }

    // =================================================
    // COMMIT LINEAGE HASH (FNV-1a STYLE)
    // =================================================

    private func fnv64(
        identity: DVSMExecutionIdentity,
        data: Data
    ) -> UInt64 {

        var hash: UInt64 = 1469598103934665603

        for b in identity.shard.utf8 {
            hash ^= UInt64(b)
            hash &*= 1099511628211
        }

        for b in data {
            hash ^= UInt64(b)
            hash &*= 1099511628211
        }

        return hash
    }
}

// =====================================================
// MARK: - CRYPTO PRIMITIVE (STUB ONLY)
// =====================================================
//
// NOTE:
// This is a deterministic placeholder.
// Real deployments MUST bind to CryptoKit SHA256.
// =====================================================

public struct SHA256 {

    public static func hash(data: Data) -> [UInt8] {
        Array(Insecure.SHA256.hash(data: data))
    }
}
