// =====================================================
// MARK: - CROSS-GROUP EXECUTION IDENTITY (NEW)
// =====================================================

public struct DVSMExecutionIdentity: Hashable, Codable {

    public let id: UUID
    public let shardID: String
    public let sequence: UInt64
    public let timestamp: UInt64

    public init(
        shardID: String,
        sequence: UInt64,
        timestamp: UInt64
    ) {
        self.id = UUID()
        self.shardID = shardID
        self.sequence = sequence
        self.timestamp = timestamp
    }
}

// =====================================================
// MARK: - EXECUTION MODE
// =====================================================

public enum DVSMExecutionMode: UInt8 {
    case strict
    case hybrid
    case adaptive
}

// =====================================================
// MARK: - EXECUTION POLICY
// =====================================================

public struct DVSMExecutionPolicy {

    public let maxInstability: Float
    public let minConfidence: Float
    public let minReliability: Float

    public func validate(
        instability: Float,
        confidence: Float,
        reliability: Float
    ) -> Bool {
        instability <= maxInstability &&
        confidence >= minConfidence &&
        reliability >= minReliability
    }
}

